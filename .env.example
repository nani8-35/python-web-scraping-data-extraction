# Copy to .env and supply your own local database password; never commit .env.
POSTGRES_USER=scraper
POSTGRES_DB=scraping
POSTGRES_PASSWORD=
# Match the local PostgreSQL credentials above (URL-encode special characters).
SCRAPING_DATABASE_URL=
SCRAPING_MAX_PAGES=2
SCRAPING_DELAY=1.0
SCRAPING_TIMEOUT=30
SCRAPING_RETRIES=2
SCRAPING_HEADLESS=true
# Optional local Chrome binary / remote Selenium service:
# SCRAPING_BROWSER_BINARY=/path/to/chrome
# SCRAPING_SELENIUM_URL=http://localhost:4444
